// XO (Tic-Tac-Toe) - two-player console game
#include <iostream>
#include <limits>
using namespace std;

class Board {
private:
    char cells[3][3];

public:
    Board() { reset(); }

    // Fill the board with the numbers 1-9 so players can pick a position
    void reset() {
        char n = '1';
        for (int i = 0; i < 3; i++)
            for (int j = 0; j < 3; j++)
                cells[i][j] = n++;
    }

    void display() const {
        cout << "\n";
        for (int i = 0; i < 3; i++) {
            cout << " " << cells[i][0] << " | " << cells[i][1] << " | " << cells[i][2] << "\n";
            if (i < 2) cout << "---+---+---\n";
        }
        cout << "\n";
    }

    // Returns false if the position is invalid or already taken
    bool place(int position, char symbol) {
        if (position < 1 || position > 9) return false;
        int row = (position - 1) / 3;
        int col = (position - 1) % 3;
        if (cells[row][col] == 'X' || cells[row][col] == 'O') return false;
        cells[row][col] = symbol;
        return true;
    }

    bool hasWon(char s) const {
        for (int i = 0; i < 3; i++) {
            if (cells[i][0] == s && cells[i][1] == s && cells[i][2] == s) return true; // row
            if (cells[0][i] == s && cells[1][i] == s && cells[2][i] == s) return true; // column
        }
        if (cells[0][0] == s && cells[1][1] == s && cells[2][2] == s) return true;     // diagonal
        if (cells[0][2] == s && cells[1][1] == s && cells[2][0] == s) return true;     // diagonal
        return false;
    }

    bool isFull() const {
        for (int i = 0; i < 3; i++)
            for (int j = 0; j < 3; j++)
                if (cells[i][j] != 'X' && cells[i][j] != 'O') return false;
        return true;
    }
};

int main() {
    Board board;
    char current = 'X';

    cout << "=== XO Game ===\n";

    while (true) {
        board.display();
        cout << "Player " << current << ", choose a position (1-9): ";

        int pos;
        if (!(cin >> pos)) {                       // user typed something that is not a number
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Please enter a number.\n";
            continue;
        }

        if (!board.place(pos, current)) {
            cout << "Invalid or taken position, try again.\n";
            continue;
        }

        if (board.hasWon(current)) {
            board.display();
            cout << "Player " << current << " wins!\n";
            break;
        }
        if (board.isFull()) {
            board.display();
            cout << "It's a draw!\n";
            break;
        }

        current = (current == 'X') ? 'O' : 'X';    // switch turn
    }
    return 0;
}
